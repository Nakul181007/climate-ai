# ClimateAI Maharashtra - Environment Configuration
# Copy this file to .env.local to configure real credentials

# Google Gemini API Key for policy parsing and climate assistant
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL & Storage (Optional for persistent database)
# Leave empty to use local rich in-memory demonstration adapter
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demonstration Mode Flag (defaults to true if API keys not set)
NEXT_PUBLIC_DEMO_MODE=true

